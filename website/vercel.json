{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "functions": {
    "api/generate-review.js": {
      "maxDuration": 30
    },
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "lib/**"
    },
    "api/ops.js": {
      "maxDuration": 15,
      "includeFiles": "lib/**"
    }
  },
  "rewrites": [
    { "source": "/api/ops/:path*", "destination": "/api/ops?path=:path*" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/crew", "destination": "/crew.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/survey", "destination": "/survey.html" },
    { "source": "/case-water", "destination": "/case-water.html" },
    { "source": "/case-fire", "destination": "/case-fire.html" },
    { "source": "/case-storm", "destination": "/case-storm.html" },
    { "source": "/case-subsidence", "destination": "/case-subsidence.html" },
    { "source": "/case-commercial", "destination": "/case-commercial.html" },
    { "source": "/case-major-loss", "destination": "/case-major-loss.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/clients", "destination": "/clients.html" },
    { "source": "/testimonials", "destination": "/testimonials.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ]
}
