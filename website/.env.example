# Required on Vercel: Project Settings → Environment Variables → Redeploy after saving

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Team portal (required to go live)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=generate-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-before-live

# Cloudinary (media CDN) — Dashboard shows Cloud name (e.g. foxrj3tm), not "capital services"
CLOUDINARY_CLOUD_NAME=foxrj3tm
CLOUDINARY_API_KEY=393616741283437
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
