# Required on Vercel: Project Settings → Environment Variables → Redeploy after saving

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Public site URL used by SEO (sitemap, canonical, Open Graph)
SITE_URL=https://www.capitalservices.com

# Team portal (required to go live)
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=generate-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-before-live

# Cloudflare Turnstile — enquiry forms. Site key is public. Secret stays server-side.
# Vercel: set both, and set VITE_TURNSTILE_SITE_KEY for the build, then redeploy.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Enquiry alerts. The recipient list is server-only. Comma-separate up to five inboxes.
# Testing can use a personal inbox. The office inbox is enquiries@capitalservices.com.
# From uses the verified sending domain notify.capitalservices.com.
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=
ENQUIRY_FROM=Capital Services <notifications@notify.capitalservices.com>

# Cloudinary (media CDN) — Dashboard shows Cloud name (e.g. foxrj3tm), not "capital services"
CLOUDINARY_CLOUD_NAME=foxrj3tm
CLOUDINARY_API_KEY=393616741283437
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
